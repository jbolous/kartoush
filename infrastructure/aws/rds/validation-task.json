{
  "family": "kartoush-demo-db-validation",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::790873128308:role/kartoush-demo-app-execution",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "tls-probe",
      "image": "790873128308.dkr.ecr.us-east-2.amazonaws.com/kartoush-demo-app@sha256:f29b648df23208ee53b6d0f6f867307d3bd710f5701d5579f5dad45e4aebd756",
      "essential": true,
      "entryPoint": [
        "sh",
        "-c"
      ],
      "command": [
        "timeout 20 openssl s_client -starttls postgres -connect \"$DB_HOST:5432\" -servername \"$DB_HOST\" -verify_hostname \"$DB_HOST\" -CAfile /app/rds-ca-bundle.pem -verify_return_error -brief </dev/null"
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "exit 0"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 1,
        "startPeriod": 0
      }
    }
  ],
  "tags": [
    {
      "key": "Project",
      "value": "kartoush"
    },
    {
      "key": "Environment",
      "value": "demo"
    },
    {
      "key": "Name",
      "value": "kartoush-demo-db-validation"
    }
  ]
}
