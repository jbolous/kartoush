{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthentication",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PullBootstrapImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:aws:ecr:us-east-2:790873128308:repository/kartoush-demo-db-bootstrap"
    },
    {
      "Sid": "InjectBootstrapCredentials",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-2:790873128308:secret:/kartoush/demo/app-giAB5K",
        "arn:aws:secretsmanager:us-east-2:790873128308:secret:rds!db-94c83594-ac1f-4ff0-a08d-734fa8620ef7-wcXxXT"
      ]
    }
  ]
}
