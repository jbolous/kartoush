{
  "family": "kartoush-demo-db-bootstrap",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::790873128308:role/kartoush-demo-db-bootstrap-execution",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "bootstrap",
      "image": "790873128308.dkr.ecr.us-east-2.amazonaws.com/kartoush-demo-db-bootstrap@sha256:df9e6f7533f0ff42ba3d2241188070c5140092b5669c8461af589d2d4f6f3caa",
      "essential": true,
      "environment": [
        {
          "name": "PGHOST",
          "value": "kartoush-demo-db.ch6amo0weh68.us-east-2.rds.amazonaws.com"
        },
        {
          "name": "PGPORT",
          "value": "5432"
        },
        {
          "name": "PGDATABASE",
          "value": "kartoush"
        },
        {
          "name": "PGSSLMODE",
          "value": "verify-full"
        },
        {
          "name": "PGSSLROOTCERT",
          "value": "/etc/ssl/certs/rds-ca-bundle.pem"
        },
        {
          "name": "PGCONNECT_TIMEOUT",
          "value": "15"
        }
      ],
      "secrets": [
        {
          "name": "PGUSER",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:790873128308:secret:rds!db-94c83594-ac1f-4ff0-a08d-734fa8620ef7-wcXxXT:username::"
        },
        {
          "name": "PGPASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:790873128308:secret:rds!db-94c83594-ac1f-4ff0-a08d-734fa8620ef7-wcXxXT:password::"
        },
        {
          "name": "APP_DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:790873128308:secret:/kartoush/demo/app-giAB5K:db_password::"
        }
      ]
    }
  ],
  "tags": [
    {
      "key": "Project",
      "value": "kartoush"
    },
    {
      "key": "Environment",
      "value": "demo"
    },
    {
      "key": "Name",
      "value": "kartoush-demo-db-bootstrap"
    }
  ]
}
