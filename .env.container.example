# Copy to .env.container and fill these values before starting Compose.
KARTOUSH_DB_PASSWORD=
KARTOUSH_INTERNAL_ADMIN_USERNAME=
KARTOUSH_INTERNAL_ADMIN_PASSWORD=
# Generate once with: openssl rand -base64 32
# Keep this value stable while retaining the database volume.
KARTOUSH_JOBS_ACTIVATION_EMAIL_ENCRYPTION_KEY=
KARTOUSH_HTTP_PORT=8080
SERVER_PORT=8080
